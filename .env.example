# Absolute production origin for metadataBase, Open Graph, sitemap, and JSON-LD.
# No trailing slash. Required in Vercel Production (and Preview if you want correct absolute URLs).
# Local dev falls back to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL=https://example.com

# GA4 measurement ID. When unset, Google Analytics is not loaded (local/dev stays clean).
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXX
